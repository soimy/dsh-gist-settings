{
  "name": "@local/dsh-gist-settings",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Back up and restore DeepSeek Harness profile configuration through GitHub Gists using the local gh CLI.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "npm run build",
    "test": "node test/entry.test.ts && node test/sync.test.ts && node test/tools.test.ts && node test/schema.test.ts && node test/regression.test.ts && node test/safety.test.ts && node test/release.test.ts && node test/docs.test.ts && node scripts/check-changelog.ts && node scripts/check-docs.ts",
    "test:entry": "npm run build && node test/entry.test.ts",
    "test:sync": "node test/sync.test.ts",
    "test:tools": "node test/tools.test.ts",
    "test:schema": "node test/schema.test.ts",
    "test:regression": "node test/regression.test.ts",
    "test:safety": "node test/safety.test.ts",
    "test:release": "node test/release.test.ts",
    "test:docs": "node test/docs.test.ts",
    "test:live": "node test/live.test.ts",
    "changelog:check": "node scripts/check-changelog.ts",
    "docs:check": "node scripts/check-docs.ts",
    "release:notes": "node scripts/release-notes.ts"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}