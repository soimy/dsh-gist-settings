{
  "name": "@local/dsh-gist-settings",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Back up and restore DeepSeek Harness profile configuration through GitHub Gists using the local gh CLI.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node test/sync.test.mjs && node test/tools.test.mjs && node test/schema.test.mjs && node test/regression.test.mjs && node test/safety.test.mjs && node test/release.test.mjs && node test/docs.test.mjs && node scripts/check-changelog.mjs && node scripts/check-docs.mjs",
    "test:sync": "node test/sync.test.mjs",
    "test:tools": "node test/tools.test.mjs",
    "test:schema": "node test/schema.test.mjs",
    "test:regression": "node test/regression.test.mjs",
    "test:safety": "node test/safety.test.mjs",
    "test:release": "node test/release.test.mjs",
    "test:docs": "node test/docs.test.mjs",
    "test:live": "node test/live.test.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}