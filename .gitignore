# dependencies
node_modules/
pnpm-lock.yaml
# The package has no dependencies and deliberately ships no lockfile, so `npm ci`
# is not a supported path. Committing one would make it look like it is.
package-lock.json

# compiled output of `npm run build`: the half the Harness loads, regenerated
# from index.ts and lib/, never edited by hand and never committed
dist/

# local runtime state (never commit: holds gist ids and local backup manifests)
.gist-settings/
*.local.json
backups/

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# git worktrees created inside the repository by `git worktree add`
.worktrees/

# logs
*.log
npm-debug.log*